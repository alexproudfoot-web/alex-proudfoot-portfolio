---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import { site } from "../site";
import portrait from "../assets/images/DSCF9214.JPG";
---

<Base
  title="About"
  description={`About ${site.name} — photography and motion, based in ${site.location}.`}
>
  <div class="shell">
    <div class="hero" data-reveal>
      <figure class="portrait frame">
        <Image
          src={portrait}
          alt={`${site.name} standing in a sunflower field, giving a thumbs up, camera around his neck.`}
          widths={[480, 720, 960]}
          sizes="(min-width: 48rem) 32rem, 90vw"
          quality={82}
          loading="eager"
        />
      </figure>

      <div class="card glass">
        <h1>{site.name}</h1>
        <p class="prose">
          {site.location} is home base, but most of the work happens
          somewhere else — a track, a driveway, a stretch of road at the
          right hour. I started shooting in 2019: cars were already the
          obsession, the camera just gave it somewhere to go. Now it's one
          thing — chasing good light, good cars, and the people who keep
          them running.
        </p>

        <p class="label contact-line">
          <a href={`mailto:${site.email}`}>{site.email}</a>
          {
            site.social.map((s) => (
              <a href={s.href} rel="me noopener">
                {s.label}
              </a>
            ))
          }
          <a href="/contact/">Inquire</a>
        </p>
      </div>
    </div>
  </div>
</Base>

<style>
  .shell {
    padding-block: var(--frame-gap);
  }

  .hero {
    position: relative;
    max-width: 58rem;
  }

  .portrait {
    margin: 0;
    width: 100%;
    aspect-ratio: 3 / 4;
  }

  .portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card {
    margin-top: -3.5rem;
    margin-inline: 1.25rem;
    padding: 2rem 1.75rem;
  }

  .card h1 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2rem, 6vw, 2.75rem);
    color: var(--cyanotype);
    letter-spacing: -0.01em;
    margin-bottom: 1rem;
  }

  .card .prose {
    font-size: var(--t-body);
    max-width: none;
  }

  .contact-line {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-top: 1.25rem;
  }

  @media (min-width: 48rem) {
    .hero {
      max-width: none;
      display: grid;
      grid-template-columns: minmax(0, 1fr) 20rem;
      align-items: end;
      gap: 2.5rem;
      justify-content: center;
    }

    .portrait {
      width: min(56vw, 48rem);
      max-width: 100%;
      aspect-ratio: 3 / 4;
    }

    .card {
      position: static;
      width: auto;
      max-width: none;
      margin: 0;
      padding: 2rem 1.75rem;
    }
  }
</style>
