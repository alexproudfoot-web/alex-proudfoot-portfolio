---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Plate from "../../components/Plate.astro";

const stills = (await getCollection("stills")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base title="Stills" description="Photographs, with archival prints available.">
  <div class="shell">
    <div class="section-head">
      <h2>Stills</h2>
      <p class="label">{stills.length} pictures</p>
    </div>

    <div class="hang">
      {
        stills.map((still) => (
          <div class:list={["slot", still.data.span]}>
            <Plate
              image={still.data.image}
              alt={still.data.alt}
              title={still.data.title}
              place={still.data.place}
              year={still.data.year}
              href={`/stills/${still.id}/`}
              sizes="(min-width: 60rem) 48vw, 92vw"
              transitionName={`still-${still.id}`}
            />
          </div>
        ))
      }
    </div>
  </div>
</Base>

<style>
  .shell {
    padding-top: var(--frame-gap);
  }

  .hang {
    display: grid;
    gap: 0.9rem;
  }

  /* Pictures are hung at different scales, the way a real wall is
     arranged: the wide ones get the room, the tall ones sit narrower. */
  @media (min-width: 60rem) {
    .hang {
      grid-template-columns: repeat(12, 1fr);
      align-items: start;
    }

    .slot.wide {
      grid-column: span 12;
    }

    .slot.standard {
      grid-column: span 7;
    }

    .slot.tall {
      grid-column: span 5;
    }
  }
</style>
