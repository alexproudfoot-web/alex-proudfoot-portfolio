---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../site";

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.discipline}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://example.com");
const ogImage = new URL("/og-image.jpg", Astro.site ?? "https://example.com");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#1b3a5c" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&family=Space+Grotesk:wght@300..700&display=swap"
    />
    <!-- Loaded up front (not on click) so Film.astro can call player.play()
         the instant the user presses play, before Safari's brief window for
         gesture-triggered autoplay closes. -->
    <script src="https://player.vimeo.com/api/player.js" is:inline></script>
    <ClientRouter />
  </head>

  <body>
    <a class="skip" href="#main">Skip to the work</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      // Fade+rise elements marked [data-reveal] into place as they enter
      // view. Runs once per element per page load (view transitions swap
      // the DOM, so this re-fires naturally on navigation).
      const revealed = new Set<Element>();

      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting && !revealed.has(entry.target)) {
              entry.target.classList.add("is-visible");
              revealed.add(entry.target);
              observer.unobserve(entry.target);
            }
          }
        },
        { rootMargin: "0px 0px -8% 0px", threshold: 0.05 },
      );

      const observe = () => {
        document.querySelectorAll("[data-reveal]").forEach((el) => {
          if (!revealed.has(el)) observer.observe(el);
        });
      };

      observe();
      document.addEventListener("astro:page-load", observe);

      // Liquid-glass specular highlight: a light that tracks the cursor
      // across any .glass panel or .glass-disc control, via --mx/--my
      // read by their ::before in global.css / Film.astro. Delegated to
      // the document so it keeps working for elements added after load
      // (the filmstrip, view-transitioned pages) with no rebinding.
      const canTrackPointer =
        window.matchMedia("(hover: hover)").matches &&
        !window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (canTrackPointer) {
        document.addEventListener("pointermove", (event) => {
          const target = (event.target as Element)?.closest?.(".glass, .glass-disc");
          if (!target) return;
          const rect = target.getBoundingClientRect();
          const el = target as HTMLElement;
          el.style.setProperty("--mx", `${((event.clientX - rect.left) / rect.width) * 100}%`);
          el.style.setProperty("--my", `${((event.clientY - rect.top) / rect.height) * 100}%`);
        });
      }
    </script>
  </body>
</html>
